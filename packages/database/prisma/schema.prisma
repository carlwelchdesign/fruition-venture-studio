generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IdeaStatus {
  NEW
  APPROVED
  RESEARCHING
  REVIEW_REQUIRED
  DECIDED
  RESEARCH_FAILED
  ARCHIVED
}

enum ResearchRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AgentRole {
  CUSTOMER_PROBLEM
  MARKET_COMPETITION
  PRODUCT_MVP
  TECHNICAL_AI
  BUSINESS_GTM
  MARKET_FINANCE
  RISK_TRUST
  STUDIO_SYNTHESIS
}

enum IdeaDisposition {
  EXPLORE
  HOLD
  DECLINE
}

enum BoardChannel {
  BOARD
  DIRECT
}

enum BoardMessageRole {
  USER
  ASSISTANT
}

enum BoardProposalStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

enum BoardSourceStatus {
  VERIFIED
  BLOCKED
  UNAVAILABLE
  UNSUPPORTED
}

enum FounderBriefStatus {
  DRAFT
  PUBLISHED
  REVOKED
}

model User {
  id                     String               @id
  name                   String
  email                  String               @unique
  emailVerified          Boolean              @default(false)
  image                  String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  sessions               Session[]
  accounts               Account[]
  auditEvents            AuditEvent[]
  notes                  AdminNote[]
  boardSessions          BoardSession[]
  reviewedBoardProposals BoardScoreProposal[] @relation("BoardProposalReviewer")
  reviewedFounderBriefs  FounderBrief[]        @relation("FounderBriefReviewer")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Submitter {
  id              String    @id @default(cuid())
  normalizedEmail String    @unique
  email           String
  name            String
  organization    String?
  anonymizedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  ideas           Idea[]

  @@index([createdAt])
}

model Idea {
  id              String           @id @default(cuid())
  publicReference String           @unique
  submitterId     String
  nameSnapshot    String
  emailSnapshot   String
  organization    String?
  projectStage    String
  projectDetails  String
  analysisConsent Boolean
  consentedAt     DateTime
  status          IdeaStatus       @default(NEW)
  disposition     IdeaDisposition?
  decidedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  submitter       Submitter        @relation(fields: [submitterId], references: [id], onDelete: Cascade)
  researchRuns    ResearchRun[]
  notes           AdminNote[]
  boardSessions   BoardSession[]
  founderBriefs   FounderBrief[]

  @@index([submitterId, createdAt])
  @@index([status, createdAt])
}

model ResearchRun {
  id            String            @id @default(cuid())
  ideaId        String
  version       Int
  status        ResearchRunStatus @default(QUEUED)
  workflowRunId String?           @unique
  model         String
  startedAt     DateTime?
  completedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  idea          Idea              @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  reports       AgentReport[]
  scorecard     Scorecard?
  boardSessions BoardSession[]
  founderBriefs FounderBrief[]

  @@unique([ideaId, version])
  @@index([ideaId, status])
}

model AgentReport {
  id             String           @id @default(cuid())
  researchRunId  String
  role           AgentRole
  title          String
  summary        String
  findings       Json
  risks          Json
  openQuestions  Json
  structuredData Json?
  confidence     Float
  createdAt      DateTime         @default(now())
  researchRun    ResearchRun      @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  sources        ResearchSource[]

  @@unique([researchRunId, role])
}

model ResearchSource {
  id            String      @id @default(cuid())
  agentReportId String
  url           String
  title         String
  snippet       String?
  publishedAt   DateTime?
  accessedAt    DateTime    @default(now())
  agentReport   AgentReport @relation(fields: [agentReportId], references: [id], onDelete: Cascade)

  @@unique([agentReportId, url])
}

model Scorecard {
  id             String           @id @default(cuid())
  researchRunId  String           @unique
  totalScore     Float
  recommendation IdeaDisposition
  confidence     Float
  summary        String
  nextSteps      Json
  createdAt      DateTime         @default(now())
  researchRun    ResearchRun      @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  dimensions     ScoreDimension[]
}

model ScoreDimension {
  id             String               @id @default(cuid())
  scorecardId    String
  key            String
  label          String
  weight         Float
  aiScore        Float
  aiRationale    String
  confidence     Float
  evidence       Json
  overrideScore  Float?
  overrideReason String?
  overriddenAt   DateTime?
  scorecard      Scorecard            @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  boardProposals BoardScoreProposal[]

  @@unique([scorecardId, key])
}

model BoardSession {
  id             String         @id @default(cuid())
  sessionKey     String         @unique
  ideaId         String
  researchRunId  String
  createdById    String
  channel        BoardChannel
  specialistRole AgentRole?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  idea           Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  researchRun    ResearchRun    @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  createdBy      User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  messages       BoardMessage[]

  @@index([ideaId, updatedAt])
  @@index([researchRunId, channel])
}

model BoardMessage {
  id               String               @id @default(cuid())
  boardSessionId   String
  role             BoardMessageRole
  speakerRole      AgentRole?
  body             String
  contributors     Json
  citations        Json
  unknownVariables Json
  createdAt        DateTime             @default(now())
  boardSession     BoardSession         @relation(fields: [boardSessionId], references: [id], onDelete: Cascade)
  scoreProposals   BoardScoreProposal[]
  verifiedSources  BoardVerifiedSource[]

  @@index([boardSessionId, createdAt])
}

model BoardVerifiedSource {
  id             String            @id @default(cuid())
  boardMessageId String
  originalUrl    String
  finalUrl       String?
  title          String?
  status         BoardSourceStatus
  statusDetail   String?
  mimeType       String?
  contentHash    String?
  extractedText  String?
  retrievedAt    DateTime?
  createdAt      DateTime          @default(now())
  boardMessage   BoardMessage      @relation(fields: [boardMessageId], references: [id], onDelete: Cascade)

  @@unique([boardMessageId, originalUrl])
  @@index([boardMessageId, status])
  @@index([contentHash])
}

model BoardScoreProposal {
  id               String              @id @default(cuid())
  boardMessageId   String
  scoreDimensionId String
  proposedScore    Float
  rationale        String
  evidence         Json
  status           BoardProposalStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime            @default(now())
  boardMessage     BoardMessage        @relation(fields: [boardMessageId], references: [id], onDelete: Cascade)
  scoreDimension   ScoreDimension      @relation(fields: [scoreDimensionId], references: [id], onDelete: Cascade)
  reviewedBy       User?               @relation("BoardProposalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([boardMessageId])
  @@index([scoreDimensionId, status])
}

model FounderBrief {
  id                    String             @id @default(cuid())
  ideaId                String
  researchRunId         String
  version               Int
  status                FounderBriefStatus @default(DRAFT)
  title                 String
  content               Json
  financials            Json?
  sources               Json
  tokenHash             String?            @unique
  expiresAt             DateTime?
  publishedAt           DateTime?
  firstViewedAt         DateTime?
  lastViewedAt          DateTime?
  viewCount             Int                @default(0)
  deliveryStatus        String?
  deliveredAt           DateTime?
  deliveryError         String?
  reviewedById          String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  idea                  Idea               @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  researchRun           ResearchRun        @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  reviewedBy            User?              @relation("FounderBriefReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([ideaId, version])
  @@index([ideaId, status, createdAt])
  @@index([researchRunId])
}

model AdminNote {
  id        String   @id @default(cuid())
  ideaId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ideaId, createdAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
}

model SecurityThrottle {
  id        BigInt   @id @default(autoincrement())
  kind      String
  scopeHash String
  createdAt DateTime @default(now())

  @@index([kind, scopeHash, createdAt])
  @@index([createdAt])
}
