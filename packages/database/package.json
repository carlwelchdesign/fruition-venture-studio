{
  "name": "@fruition/database",
  "version": "0.2.0",
  "private": true,
  "exports": {
    ".": "./src/client.ts"
  },
  "scripts": {
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma.config.ts",
    "postinstall": "prisma generate --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.22.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "prisma": "^7.9.1"
  }
}
