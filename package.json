{
  "name": "fruition-platform",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev --workspace @fruition/site",
    "dev:site": "npm run dev --workspace @fruition/site",
    "dev:admin": "npm run dev --workspace @fruition/admin",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint apps packages",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @fruition/database",
    "db:migrate": "npm run db:migrate --workspace @fruition/database",
    "db:deploy": "npm run db:deploy --workspace @fruition/database",
    "verify:boundaries": "node scripts/verify-boundaries.mjs"
  },
  "overrides": {
    "workflow": {
      "@swc/cli": {
        "minimatch": "10.2.6"
      }
    },
    "filelist": {
      "minimatch": "10.2.6"
    },
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
